# Existing local paths
CRAWLLER_PROJECT_ROOT=../..
CRAWLLER_RECON_ROOT=../../recon_runs
CRAWLLER_DATABASE_PATH=./data/crawller_web.db

# PRODUCTION: Supabase PostgreSQL connection string.
# Use the Supabase "Session pooler" connection string for the persistent
# FastAPI backend when your environment is IPv4-only.
# Leave empty to keep using local SQLite.
CRAWLLER_DATABASE_URL=

CRAWLLER_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CRAWLLER_MAX_CONCURRENT_SCANS=1
CRAWLLER_API_KEY=
CRAWLLER_MOCK_SCANNER=false
CRAWLLER_SKIP_SHODAN=true
