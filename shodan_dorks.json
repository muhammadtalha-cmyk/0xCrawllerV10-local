[
  {
    "id": "scope_inventory",
    "category": "asset_inventory",
    "purpose": "Baseline inventory for the selected organization scope.",
    "query_template": "{scope}",
    "scope_types": [
      "hostname",
      "org",
      "asn",
      "net"
    ],
    "facets": "port,org,product,asn",
    "enabled_by_default": true
  },
  {
    "id": "certificate_cn_exact",
    "category": "tls_asset_discovery",
    "purpose": "Find services whose certificate common name equals the target domain.",
    "query_template": "{scope} ssl.cert.subject.cn:\"{target}\"",
    "scope_types": [
      "target"
    ],
    "facets": "ssl.cert.issuer.cn,port,org",
    "enabled_by_default": true
  },
  {
    "id": "certificate_cn_wildcard",
    "category": "tls_asset_discovery",
    "purpose": "Find services presenting a wildcard certificate for the target domain.",
    "query_template": "{scope} ssl.cert.subject.cn:\"*.{target}\"",
    "scope_types": [
      "target"
    ],
    "facets": "ssl.cert.issuer.cn,port,org",
    "enabled_by_default": true
  },
  {
    "id": "ssl_text_reference",
    "category": "tls_asset_discovery",
    "purpose": "Find SSL/TLS metadata that references the target domain.",
    "query_template": "{scope} ssl:\"{target}\"",
    "scope_types": [
      "target"
    ],
    "facets": "ssl.cert.subject.cn,ssl.cert.issuer.cn,port,org",
    "enabled_by_default": true
  },
