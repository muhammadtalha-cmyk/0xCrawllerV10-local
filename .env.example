# ============================================================
# 0xCrawllerV10 — Docker Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then start the system:
#   docker compose up -d
# Or use the helper script:
#   ./START_SYSTEM.sh
# ============================================================

# ─── PostgreSQL Database ─────────────────────────────────────
POSTGRES_USER=recon
POSTGRES_PASSWORD=reconpass
POSTGRES_DB=recondb

# ─── Backend / JWT Authentication ────────────────────────────
# REQUIRED: Generate a strong secret with:
#   openssl rand -hex 32
CRAWLLER_JWT_SECRET=changeme_generate_with_openssl_rand_hex_32

# ─── CORS: comma-separated allowed frontend origins ──────────
# For local dev use the defaults. For a server deployment, set
# the real public URL (e.g. https://crawller.example.com)
CRAWLLER_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Optional: internal API key for worker→backend calls ─────
# Leave blank to disable API key auth
CRAWLLER_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────
# The URL the browser uses to reach the backend.
# For local use: http://localhost:8000
# For a server: https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=

# ─── Shodan (optional — enables passive enrichment) ──────────
# Leave blank to skip Shodan (--skip-shodan is implied).
SHODAN_API_KEY=
